_RADIO_CODE":"511P  ","FINAL_CALL_TYPE":"SUBJECT STOP                                      ","CALL_RECEIVED":"09/24/2026 12:42:26 PM","HUNDREDBLOCKADDR":"60XX N 19TH AV","GRID":"CB25  "},{"_id":515702,"INCIDENT_NUM":"26001338508","DISP_CODE":"R","DISPOSITION":"DEPARTMENTAL REPORT","FINAL_RADIO_CODE":"415F  ","FINAL_CALL_TYPE":"DOMESTIC VIOLENCE                                 ","CALL_RECEIVED":"09/24/2026 12:41:56 AM","HUNDREDBLOCKADDR":"71XX S 51ST AV","GRID":"AB17  "},{"_id":516614,"INCIDENT_NUM":"26001340786","DISP_CODE":"R","DISPOSITION":"DEPARTMENTAL REPORT","FINAL_RADIO_CODE":"601J  ","FINAL_CALL_TYPE":"MISSING JUVENILE                                  ","CALL_RECEIVED":"09/24/2026 12:41:55 PM","HUNDREDBLOCKADDR":"40XX N 67TH AV","GRID":"BG12  "}], "fields": [{"id": "_id", "type": "int"}, {"id": "INCIDENT_NUM", "type": "text", "info": {"notes": "A 12 digit numeric field that is the unique identifier for each call for police service.  The first 4 fdigits refer to the year the call was received in.", "type_override": "", "label": "Call Incident Number"}}, {"id": "DISP_CODE", "type": "text", "info": {"notes": "A single digit field that reflects how the call was cleared.  Clearing a call is also referred to as giving a disposition on a call.   Examples of dispositions include \"Accident Report\", \"No Action Required\", \"Departmental Report\", etc.", "type_override": "", "label": "Disposition Code"}}, {"id": "DISPOSITION", "type": "text", "info": {"notes": "The look-up or brief description of what the Disposition Code refers to.", "type_override": "", "label": "Disposition"}}, {"id": "FINAL_RADIO_CODE", "type": "text", "info": {"notes": "Each call is assigned a radio code that gives a description of what type of incident it is.  For example, a radio code of 647 refers to a call about a suspicious person, a radio code of 459R refers to a call about a residential burglary, etc..  Calls receive an initial radio code when the call is first received based on the information provided by the caller.   That radio code can be updated once officers arrive on scene and obtain additional information.  The final radio code is the radio code after any updates were made.   An 'X' on the end of a radio code indicates it was an attempt.  For example, the radio code 459RX refers to an attempted residential burglary. ", "type_override": "", "label": "Final Radio Code"}}, {"id": "FINAL_CALL_TYPE", "type": "text", "info": {"notes": "The look-up or brief description of what the Final Radio Code refers to.", "type_override": "", "label": "Final Radio Code Description"}}, {"id": "CALL_RECEIVED", "type": "text", "info": {"notes": "The date and time the call for police service was received.", "type_override": "", "label": "Date and Time Call Was Received"}}, {"id": "HUNDREDBLOCKADDR", "type": "text", "info": {"notes": "The address where the caller requested police service, anonymized to the hundred block for victim confidentiality.  Note that this address can be different than the address of the person calling if the caller is requesting service about an address different than their own.  For example, a caller may call to report a loud party at an address down the street.  The address provided here would be the address of the party.", "type_override": "", "label": "Hundred Block Address"}}, {"id": "GRID", "type": "text", "info": {"notes": "The City of Phoenix is divided into small geographic areas referred to as grids.  Grids are approximately quarter square mile areas, and grid boundaries tend to fall on main streets.  Some intersection addresses fall cleanly into one grid and some fall on the border of multiple grids.  The calls for service records where the address falls on the border of multiple grids will not have a grid assigned for that call in this data set. ", "type_override": "", "label": "Grid"}}], "_links": {"start": "/api/3/action/datastore_search?resource_id=ed707785-26b6-4949-9b04-5700b8a0125c&sort=%22CALL_RECEIVED%22+desc&limit=50", 